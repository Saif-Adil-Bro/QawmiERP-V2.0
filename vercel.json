{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/monthly-fees",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/overdue-reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/absence-alerts",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/process-queues",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/digest-reports",
      "schedule": "0 2 * * 5"
    },
    {
      "path": "/api/cron/early-warning",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/anomalies",
      "schedule": "0 21 * * *"
    }
  ]
}
