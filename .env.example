# ─────────────────────────────────────────────────────────────────────────────
# লোকাল সেটআপ:
#   এই ফাইলটি কপি করে প্রজেক্ট রুটে .env.local বানান, তারপর নিচের মানগুলো দিন:
#       cp .env.example .env.local
#
#   .env.local কখনোই Git-এ কমিট করবেন না — এটি .gitignore-এ আছে এবং
#   আসল কী শুধু আপনার মেশিনে/হোস্টিং প্ল্যাটফর্মে থাকবে।
#
# প্রোডাকশন (Railway / Vercel / Docker):
#   .env.local ফাইল রিপোতে বা সার্ভারে আপলোড করবেন না। হোস্টিং ড্যাশবোর্ডের
#   "Environment Variables" / "Variables" ট্যাবে প্রতিটি কী আলাদাভাবে সেট করুন।
#   Railway: Service → Variables → Raw Editor
#   Vercel : Project → Settings → Environment Variables (Production/Preview/Development)
#
# ⚠️ NEXT_PUBLIC_* প্রিফিক্সযুক্ত মান ব্রাউজারে পাবলিক হয়ে যায় —
#    সেখানে কখনো SUPABASE_SERVICE_ROLE_KEY বা অন্য কোনো গোপন কী রাখবেন না।
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FREEIMAGE_API_KEY=
IMGBB_API_KEY=
NEXT_PUBLIC_FREEIMAGE_API_KEY=
NEXT_PUBLIC_IMGBB_API_KEY=
GEMINI_API_KEY=
# ─────────────────────────────────────────────────────────────────────────────
# (ঐচ্ছিক) পাবলিক পেজের ডিফল্ট মাদরাসা — UUID।
# ভর্তি/দান/পেমেন্ট-কনফিগে anonymous visitor-কে কোন মাদরাসা "ডিফল্ট" ধরা হবে।
# না দিলে সবচেয়ে পুরোনো মাদরাসা ধরা হয়। Staff action-এ কোনো ভূমিকা নেই।
DEFAULT_MADRASA_ID=
