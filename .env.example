# ─────────────────────────────────────────────────────────────────────────────
# লোকাল সেটআপ:
#   এই ফাইলটি কপি করে প্রজেক্ট রুটে .env.local বানান, তারপর নিচের মানগুলো দিন:
#       cp .env.example .env.local
#
#   .env.local কখনোই Git-এ কমিট করবেন না — এটি .gitignore-এ আছে এবং
#   আসল কী শুধু আপনার মেশিনে/হোস্টিং প্ল্যাটফর্মে থাকবে।
#
# প্রোডাকশন (Railway / Vercel / Docker):
#   .env.local ফাইল রিপোতে বা সার্ভারে আপলোড করবেন না। হোস্টিং ড্যাশবোর্ডের
#   "Environment Variables" / "Variables" ট্যাবে প্রতিটি কী আলাদাভাবে সেট করুন।
#   Railway: Service → Variables → Raw Editor
#   Vercel : Project → Settings → Environment Variables (Production/Preview/Development)
#
# ⚠️ NEXT_PUBLIC_* প্রিফিক্সযুক্ত মান ব্রাউজারে পাবলিক হয়ে যায় —
#    সেখানে কখনো SUPABASE_SERVICE_ROLE_KEY বা অন্য কোনো গোপন কী রাখবেন না।
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional stable server-only key for encrypted pre-migration Hifz settings (see docs/hifz-upgrade.bn.md).
HIFZ_STORAGE_KEY=
FREEIMAGE_API_KEY=
IMGBB_API_KEY=
NEXT_PUBLIC_FREEIMAGE_API_KEY=
NEXT_PUBLIC_IMGBB_API_KEY=
GEMINI_API_KEY=
# ─────────────────────────────────────────────────────────────────────────────
# (ঐচ্ছিক) পাবলিক পেজের ডিফল্ট মাদরাসা — UUID।
# ভর্তি/দান/পেমেন্ট-কনফিগে anonymous visitor-কে কোন মাদরাসা "ডিফল্ট" ধরা হবে।
# না দিলে সবচেয়ে পুরোনো মাদরাসা ধরা হয়। Staff action-এ কোনো ভূমিকা নেই।
DEFAULT_MADRASA_ID=

# ─────────────────────────────────────────────────────────────────────────────
# মোবাইল অ্যাপ REST API (/api/mobile/*) কনফিগারেশন:
#   MOBILE_API_KEY      : production-এ আবশ্যক; অনুমোদিত মোবাইল ক্লায়েন্টের x-api-key। এটি ব্যবহারকারীর Bearer session-এর বিকল্প নয়।
#   NEXT_PUBLIC_APP_URL : এই পরিবেশের HTTPS origin (path/query নয়); মিডিয়া ও পেমেন্ট callback-এর জন্য।
#   build-এর আগেই placeholder বদলান; staging থেকে production-এ fallback নেই।
#   SSLCommerz Store ID/password প্রতি প্রতিষ্ঠানের gateway settings-এ; NEXT_PUBLIC_* secret নয়।
# ─────────────────────────────────────────────────────────────────────────────
MOBILE_API_KEY=
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# ইন্টিগ্রেটেড এআই অ্যাসিস্ট্যান্ট (OpenRouter Free Models / Groq API):
#   OPENROUTER_API_KEY : OpenRouter (https://openrouter.ai/keys) বা Groq API Key
#   AI_MODEL_NAME      : ডিফল্ট ফ্রি রাউটার (openrouter/free সবসময় সক্রিয় ফ্রি মডেল বেছে নেয়)
# ─────────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
AI_MODEL_NAME=openrouter/free

# ─────────────────────────────────────────────────────────────────────────────
# Capacitor Android App কনফিগারেশন:
#   NEXT_PUBLIC_API_URL   : (ঐচ্ছিক) ক্লায়েন্ট-সাইড /api/* কলের জন্য লাইভ সার্ভার URL
#   CAPACITOR_SERVER_URL  : Capacitor WebView-এ লোড হওয়ার জন্য লাইভ Next.js সার্ভার URL
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com
CAPACITOR_SERVER_URL=https://your-domain.com

# ─────────────────────────────────────────────────────────────────────────────
# Phase 2 Automation & Cron Engine (Feature 2.1):
#   CRON_SECRET                : GitHub Actions / External Cron Bearer token secret
#   DISABLE_IN_APP_SCHEDULER   : (ঐচ্ছিক) 'true' দিলে ইন-অ্যাপ Node.js শিডিউলার বন্ধ থাকবে
#   AUTOMATION_POLL_INTERVAL_MS: (ঐচ্ছিক) ইন-অ্যাপ পোলিং বিরতি (ডিফল্ট: 300000 = ৫ মিনিট)
#   AUTOMATION_STARTUP_DELAY_MS: (ঐচ্ছিক) সার্ভার চালুর পর প্রথম চেকের বিলম্ব (ডিফল্ট: 30000)
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=
DISABLE_IN_APP_SCHEDULER=false
AUTOMATION_POLL_INTERVAL_MS=300000
AUTOMATION_STARTUP_DELAY_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# Multi-Channel Notification Orchestrator (Feature 2.2):
#   WHATSAPP_ACCESS_TOKEN    : Meta WhatsApp Cloud API permanent/system token
#   WHATSAPP_PHONE_NUMBER_ID : Meta WhatsApp Business phone number ID
#   WHATSAPP_API_VERSION     : Graph API version (default: v20.0)
#   RESEND_API_KEY           : Resend transactional email API key
#   RESEND_FROM_EMAIL        : Verified sender email (e.g. noreply@domain.com)
#   FCM_SERVER_KEY           : Firebase Cloud Messaging server key (Push)
#   SMS_API_KEY              : Fallback SMS gateway API key
#   SMS_API_URL              : Fallback SMS gateway endpoint URL
#   SMS_SENDER_ID            : Fallback SMS masking/sender ID
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FCM_SERVER_KEY=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=

# Optional stable server-only encryption secret for pre-migration clinical records.
# Configure before first use; see docs/student-health.bn.md before rotating any key.
STUDENT_HEALTH_STORAGE_KEY=
